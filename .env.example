# Copy this file to .env and fill in your own values. Never commit .env.
# Find both in the Supabase dashboard: Project Settings -> API Keys.
# The anon/publishable key is designed to ship inside the app; data is
# protected by row-level security, not by keeping this key secret.
# Never put the service_role / secret key in this app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
